# Google-only authentication. Checkout remains closed until its backend is connected.
# Google is the only authentication method; no mock-login switch exists.
# Public Supabase project credentials (never use a service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No service-role key is used or required by the browser app.
# Server-only. Set this in the hosting environment; never prefix with NEXT_PUBLIC.
# Required for trusted receipt verification. Do not paste the key into chat or commit it.
SUPABASE_SERVICE_ROLE_KEY=
