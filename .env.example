# Explicitly opt into the device-local preview, including production preview builds.
# Without mock mode, checkout/login are disabled pending the production integration.
NEXT_PUBLIC_APP_MODE=mock
# Reserved for the later Supabase integration. Mock mode never writes to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No service-role key is used or required by the browser app.
